// ===== ДАННЫЕ СТУДЕНТА - ЗАМЕНИТЕ НА СВОИ =====
// Номер в списке группы (десятичное число)
`define STUDENT_NUMBER   32'd10
// Дата в формате дд.мм.гггг: цифры записываются как hex-цифры (25.10.2026 -> 32'h25102026)
`define STUDENT_DATE     32'h25_10_2026
// Первые 4 буквы фамилии и имени (латиницей, ASCII; первая буква - старший байт)
`define STUDENT_SURNAME  "Tish"
`define STUDENT_NAME     "Arin"
